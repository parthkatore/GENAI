# ── Version control ──────────────────────────────────────────────
.git
.gitignore

# ── Python cache ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# ── Virtual environments ──────────────────────────────────────────
.venv/
venv/
env/

# ── Secrets — NEVER bake into the image ──────────────────────────
.env
*.secret
secrets.py

# ── ChromaDB index (large binary — rebuilt at container start) ────
data/chroma_db/

# ── HuggingFace model cache (downloaded at runtime) ──────────────
.hf_cache/

# ── IDE / OS artefacts ───────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Docs / screenshots (not needed in image) ─────────────────────
docs/screenshots/

# ── Build / dist artefacts ───────────────────────────────────────
dist/
build/
*.egg-info/

# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/
