# ArduinoMate Chat API — Environment Variables
# -----------------------------------------------
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to git.

# LLM Provider: "groq" (default) or "gemini"
PROVIDER=groq

# --- Groq (https://console.groq.com) ---
# Free tier available. Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model (default: llama3-8b-8192)
# GROQ_MODEL=llama3-8b-8192

# --- Google Gemini (https://aistudio.google.com) ---
# Only needed when PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
