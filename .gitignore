# ============================================================
# ArduinoMate — .gitignore
# ============================================================

# ------ Secrets — NEVER commit ------
.env
*.secret
secrets.py

# ------ Python bytecode ------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ------ Virtual environments ------
.venv/
venv/
env/
ENV/

# ------ Tool caches ------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ------ IDE / editor ------
.vscode/
.idea/
*.swp
*.swo
*~

# ------ OS ------
.DS_Store
Thumbs.db
desktop.ini

# ------ Build / packaging ------
dist/
build/
*.egg-info/
*.whl
*.tar.gz

# ------ Logs ------
*.log
logs/

# ------ Jupyter ------
.ipynb_checkpoints/
*.ipynb

# ------ Data: generated / large binary ------
# ChromaDB index — large binary, rebuilt automatically on startup
data/chroma_db/
*.sqlite3
*.bin
*.parquet

# HuggingFace model weights — downloaded at runtime (can be GBs)
.hf_cache/
**/.hf_cache/
hf_cache/

# ------ Runtime data ------
# User feedback collected at runtime — not source code
data/feedback.json
data/feedback*.json

# ------ Legacy folders — kept locally for reference, not needed in repo ------
# Week-1 code before the project was restructured into app/
ArduinoMate/

# Original scratch folder from day 1-2
GEN_AI/

# ------ Root-level prototype files replaced by proper implementation ------
Day1_intro.py
Day2_menu.py
client.py
index.html
script.js

# ------ Docs: empty placeholder ------
docs/screenshots/

# ------ Docker local artifacts ------
.dockerenv
